// ============================================================
// DR-01 | Entra ID Password Spray: Behavioural Detection
// Case: CASE-15 | ATT&CK: T1110.003 (Credential Access)
// Platform: Defender XDR > Advanced hunting > Create detection rule
// Severity: Medium | Suggested frequency: every hour
// Entities: AccountObjectId / AccountUpn (each targeted identity), IPAddress
// Status: DRAFT v0.1 (validate and tune after the simulation)
// ------------------------------------------------------------
// Logic: one source IP producing failed-credential sign-ins across
// several distinct accounts in a short window.
// Deliberately does NOT rely on Identity Protection risk, which is
// only scored when the correct password is used.
// Output: one row per targeted account, so every identity is
// mapped as an impacted entity on the alert.
// ============================================================
let lookback = 1h;
let minTargetedAccounts = 3;   // lab value: set to the number of accounts you target; production often 10+
let minFailedAttempts = 6;     // lab value: tune against your tenant's baseline
let CredentialFailureCodes = dynamic([50126, 50053, 50055, 50056]);
// 50126 invalid username or password | 50053 account locked (smart lockout)
// 50055 expired password             | 50056 no password stored
let SprayingIPs =
    EntraIdSignInEvents
    | where Timestamp > ago(lookback)
    | where ErrorCode in (CredentialFailureCodes)
    | summarize FailedAttempts = count(),
                TargetedAccounts = dcount(AccountUpn)
                by IPAddress
    | where TargetedAccounts >= minTargetedAccounts
        and FailedAttempts >= minFailedAttempts;
EntraIdSignInEvents
| where Timestamp > ago(lookback)
| where ErrorCode in (CredentialFailureCodes)
| join kind=inner SprayingIPs on IPAddress
| summarize arg_max(Timestamp, *) by AccountUpn, IPAddress
| project Timestamp, AccountUpn, AccountObjectId, AccountDisplayName,
          IPAddress, Country, City, Application, ErrorCode,
          TargetedAccounts, FailedAttempts, UserAgent
