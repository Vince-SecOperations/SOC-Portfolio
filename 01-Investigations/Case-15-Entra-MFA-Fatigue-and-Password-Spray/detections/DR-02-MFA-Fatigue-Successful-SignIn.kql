// ============================================================
// DR-02 | Identity Takeover: MFA Fatigue -> Anomalous Success
// Case 15 | ATT&CK T1621 -> T1078.004 | Platform: Defender XDR custom detection
// Behaviour, no indicators:
//   (1) a burst of unsatisfied MFA for an identity (fatigue)
//   (2) an INTERACTIVE success for that identity, after the pressure
//   (3) from a source NEW for that identity (vs its own 30-day baseline)
// Severity: High (Critical on a critical-asset identity) | Entities: AccountObjectId, IPAddress
// Window = 7d for validation/first-run capture; production: let frequency drive the window.
// ============================================================
let pressureWindow = 7d;
let baselineWindow = 30d;
let minMfaFailures = 3;
let MfaChallengeCodes = dynamic([500121, 50074, 50076, 50203]);  // 50203: confirm via error-code lookup
let MfaPressure =
    EntraIdSignInEvents
    | where Timestamp > ago(pressureWindow)
    | where tostring(LogonType) !contains "nonInteractive"
    | where ErrorCode in (MfaChallengeCodes)
    | summarize MfaFailures = count(),
                FirstPressure = min(Timestamp), LastPressure = max(Timestamp)
      by AccountObjectId
    | where MfaFailures >= minMfaFailures;
let KnownSurface =
    EntraIdSignInEvents
    | where Timestamp between (ago(baselineWindow) .. ago(pressureWindow))
    | where ErrorCode == 0
    | summarize by AccountObjectId, IPAddress;
EntraIdSignInEvents
| where Timestamp > ago(pressureWindow)
| where ErrorCode == 0
| where tostring(LogonType) !contains "nonInteractive"
| join kind=inner MfaPressure on AccountObjectId
| where Timestamp >= FirstPressure
| join kind=leftanti KnownSurface on AccountObjectId, IPAddress
| summarize arg_max(Timestamp, *) by AccountObjectId, IPAddress
| project Timestamp, ReportId, AccountUpn, AccountObjectId, IPAddress, Country, City,
          Application, MfaFailures, FirstPressure, LastPressure,
          RiskLevelAggregated, RiskState, IsManaged, IsCompliant, UserAgent
