// ============================================================
// DR-02 | MFA Fatigue Followed by Successful Sign-in from an External Source
// Case: CASE-15 | ATT&CK: T1621 -> T1078.004
// Platform: Defender XDR > Advanced hunting > Create detection rule
// Severity: High (treat as Critical when the account is a priority/critical asset)
// Entities: AccountObjectId / AccountUpn (the victim), IPAddress
// Status: DRAFT v0.1 (validate and tune after the simulation)
// ------------------------------------------------------------
// Logic (impact):
//   1. An account receives repeated MFA failures/denials from one source IP
//   2. That SAME account then signs in SUCCESSFULLY from that SAME source
//   3. The source is outside known corporate ranges (external)
// AlsoSprayed adds context: the source IP also sprayed other accounts.
// This is where Identity Protection risk becomes meaningful: the
// correct password was used, so RiskLevelAggregated/RiskState can score.
// ============================================================
let lookback = 2h;
let minMfaFailures = 3;                              // lab value: tune
let MfaFailureCodes = dynamic([500121]);             // strong-auth step failed/denied/timed out (confirm against your results)
let CredentialFailureCodes = dynamic([50126, 50053, 50055, 50056]);
let CorporateEgressRanges = dynamic(["203.0.113.0/24"]); // placeholder: replace with known office/VPN egress ranges
// 1) Accounts put under MFA pressure, per source IP
let MfaPressure =
    EntraIdSignInEvents
    | where Timestamp > ago(lookback)
    | where ErrorCode in (MfaFailureCodes)
    | summarize MfaFailures = count(),
                FirstMfaFailure = min(Timestamp),
                LastMfaFailure = max(Timestamp)
                by AccountUpn, IPAddress
    | where MfaFailures >= minMfaFailures;
// 2) Source IPs that also sprayed other accounts (context flag)
let SprayingIPs =
    EntraIdSignInEvents
    | where Timestamp > ago(lookback)
    | where ErrorCode in (CredentialFailureCodes)
    | summarize TargetedAccounts = dcount(AccountUpn) by IPAddress
    | where TargetedAccounts >= 2
    | project IPAddress, AlsoSprayed = true;
// 3) Impact: successful sign-in to the same account, same source, after the prompts
EntraIdSignInEvents
| where Timestamp > ago(lookback)
| where ErrorCode == 0
| join kind=inner MfaPressure on AccountUpn, IPAddress
| where Timestamp > FirstMfaFailure
| extend IsCorporateIP = coalesce(ipv4_is_in_any_range(IPAddress, CorporateEgressRanges), false)
| where not(IsCorporateIP)
| join kind=leftouter SprayingIPs on IPAddress
| extend AlsoSprayed = coalesce(AlsoSprayed, false)
| summarize arg_max(Timestamp, *) by AccountUpn, IPAddress
| project Timestamp, AccountUpn, AccountObjectId, AccountDisplayName,
          IPAddress, Country, City, Application,
          MfaFailures, FirstMfaFailure, LastMfaFailure, AlsoSprayed,
          RiskLevelAggregated, RiskState, IsManaged, IsCompliant, UserAgent
